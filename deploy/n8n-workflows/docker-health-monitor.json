{
  "name": "Docker Health Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "trigger-cron",
      "name": "Every 5 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "operation": "executeTool",
        "toolName": "health_report",
        "toolParameters": "={\n  \"cpu_threshold\": 80,\n  \"mem_threshold\": 85,\n  \"restart_threshold\": 3\n}"
      },
      "id": "mcp-health-report",
      "name": "DockerMCP — health_report",
      "type": "n8n-nodes-mcp.mcpClientTool",
      "typeVersion": 1,
      "position": [440, 300],
      "credentials": {
        "mcpClientApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "DockerMCP HTTP"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "critical-positive",
              "leftValue": "={{ $json.summary.critical_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-critical",
      "name": "Critical alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst alerts = data.alerts || [];\nconst critical = alerts.filter(a => a.severity === 'critical');\nconst lines = critical.map(a => `• [${a.kind}] *${a.container}* — ${a.message}`);\nconst header = `🚨 *DockerMCP — ${critical.length} alerte(s) critique(s)*`;\nconst summary = `Total: ${data.summary.alerts_total} | Critical: ${data.summary.critical_count} | Warning: ${data.summary.warning_count}`;\nreturn [{ json: { text: `${header}\\n${summary}\\n\\n${lines.join('\\n')}` } }];"
      },
      "id": "format-message",
      "name": "Format Telegram message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_notification": false
        }
      },
      "id": "telegram-send",
      "name": "Telegram — alerte",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1160, 220],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Telegram IT-Ops"
        }
      }
    }
  ],
  "connections": {
    "Every 5 min": {
      "main": [[{ "node": "DockerMCP — health_report", "type": "main", "index": 0 }]]
    },
    "DockerMCP — health_report": {
      "main": [[{ "node": "Critical alerts?", "type": "main", "index": 0 }]]
    },
    "Critical alerts?": {
      "main": [
        [{ "node": "Format Telegram message", "type": "main", "index": 0 }],
        []
      ]
    },
    "Format Telegram message": {
      "main": [[{ "node": "Telegram — alerte", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true
  },
  "tags": [
    { "name": "dockermcp" },
    { "name": "monitoring" }
  ]
}
