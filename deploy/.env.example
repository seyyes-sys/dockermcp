# =============================================================
# DockerMCP Suite — variables d'environnement
# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.
# =============================================================

# --- DockerMCP : tokens d'authentification HTTP ---------------
# Format : "token1:role1,token2:role2"
# Rôles : viewer | operator | admin
# Génère des tokens forts : `python -c "import secrets; print(secrets.token_urlsafe(48))"`
DOCKERMCP_TOKENS=CHANGE_ME_admin_token:admin,CHANGE_ME_ops_token:operator

# Token utilisé par n8n pour appeler DockerMCP (rôle minimum requis)
N8N_DOCKERMCP_TOKEN=CHANGE_ME_ops_token

# Token utilisé par OpenClaw pour appeler DockerMCP
OPENCLAW_DOCKERMCP_TOKEN=CHANGE_ME_ops_token

# Mode lecture seule global (true = refuse toute action destructive)
DOCKERMCP_READ_ONLY=false

# Niveau de log (DEBUG / INFO / WARNING / ERROR)
DOCKERMCP_LOG_LEVEL=INFO

# Bind-mount whitelist (chemins hôte autorisés, séparés par ':')
# Laisser vide = aucun bind-mount autorisé via MCP (recommandé)
DOCKERMCP_ALLOWED_BIND_ROOTS=
# Protection anti DNS-rebinding du SDK MCP
# Liste CSV des Host headers autorisés (= les domaines via lesquels on
# accède au serveur). Par défaut le compose pré-remplit pour Hexotik.
DOCKERMCP_ALLOWED_HOSTS=dockermcp.hexotik.ovh,dockermcp,dockermcp:8765,localhost,127.0.0.1
DOCKERMCP_ALLOWED_ORIGINS=https://dockermcp.hexotik.ovh,https://n8n-it.hexotik.ovh
# Tag d'image DockerMCP à déployer (latest | v0.1.0 | sha-abc1234)
DOCKERMCP_IMAGE_TAG=latest

# --- n8n IT-Ops ----------------------------------------------
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_strong_password

# --- OpenClaw IT-Ops (profile=openclaw uniquement) ------------
# Bot Telegram dédié IT-Ops (DIFFÉRENT du bot ai2cook)
TELEGRAM_ITOPS_BOT_TOKEN=
TELEGRAM_ITOPS_CHAT_ID=
ANTHROPIC_API_KEY=
